# Copy these into Portainer's "Environment variables" form (or a stack.env file). Never commit real values.
# Rename a key to OFF_<KEY> to mute that channel (alerts are skipped when NTFY_TOPIC or SMTP_HOST is unset).

# ---- Modem and checks ----
MODEM_URL=http://192.168.100.1
CHECK_SECONDS=60
MODEM_POLL_SECONDS=300
DOWN_AFTER_FAILURES=2
CHECK_TARGETS=1.1.1.1:443,8.8.8.8:53,9.9.9.9:443
UNCORR_ALERT_THRESHOLD=1000
ALERT_COOLDOWN_MIN=30
CHANNELS_RETENTION_DAYS=60
DASHBOARD_PORT=8088
DASHBOARD_URL=

# ---- Heartbeat (healthchecks.io ping URL; sent only while the internet is up) ----
HEALTHCHECK_URL=

# ---- Push (ntfy). Pick a long random topic; anyone who knows it can read it ----
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# ---- Email (Gmail app password, not your normal password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
